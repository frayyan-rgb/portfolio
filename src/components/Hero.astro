---
import { siteConfig } from "../config";
---

<div
  id="hero"
  class="relative min-h-screen overflow-hidden flex items-center"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div class="relative z-10 w-full px-6 py-32 sm:px-10 md:px-14 lg:pl-16 lg:pr-20 xl:pr-24">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(360px,480px)] lg:gap-12 xl:grid-cols-[minmax(0,1fr)_minmax(440px,600px)]">
      <div class="max-w-4xl">
      <p class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-slate-300 animate-fade-in">
        Hello! <span aria-hidden="true">👋</span>
      </p>

      <h1 class="mt-6 sm:mt-8 text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-9xl font-bold tracking-tight text-white animate-fade-in animation-delay-200">
        I'm <span style={{ color: siteConfig.accentColor }}>{siteConfig.name}</span>
      </h1>

      <p class="mt-5 sm:mt-7 text-lg sm:text-xl md:text-2xl font-medium text-slate-300 animate-fade-in animation-delay-400">
        {siteConfig.title}
      </p>

      <p class="mt-5 max-w-3xl text-base sm:text-lg md:text-xl leading-relaxed text-slate-400 animate-fade-in animation-delay-600">
        I build on-device AI tools, local-LLM pipelines at scale,
        privacy-focused machine learning systems, and production-ready
        full-stack applications.
      </p>

      <div class="mt-8 flex flex-wrap gap-3 animate-fade-in animation-delay-800">
        <a
          href="/Rayyan_Resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-lg px-6 py-3 text-base font-semibold text-slate-950 transition-opacity hover:opacity-80"
          style={`background-color: ${siteConfig.accentColor}`}
        >
          Resume <span class="ml-2" aria-hidden="true">↗</span>
        </a>
        <button
          type="button"
          data-surprise
          class="inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-900/70 px-6 py-3 text-base font-semibold text-slate-200 transition-colors hover:border-slate-500 hover:bg-slate-800"
        >
          Surprise
        </button>
      </div>

        <div class="mt-7 flex items-center gap-6 text-slate-300 animate-fade-in animation-delay-1000">
        <a
          href={`mailto:${siteConfig.social.email}`}
          aria-label="Email"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8">
            <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
            <path d="M3 7l9 6l9 -6" />
          </svg>
        </a>

        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8">
            <path d="M8 11v5" />
            <path d="M8 8v.01" />
            <path d="M12 16v-5" />
            <path d="M16 16v-3a2 2 0 1 0 -4 0" />
            <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
          </svg>
        </a>

        <a
          href={`tel:${siteConfig.social.phone.replace(/[^+\d]/g, "")}`}
          aria-label="Phone"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8">
            <path d="M5 4h4l2 5l-3 2a11 11 0 0 0 5 5l2 -3l5 2v4a2 2 0 0 1 -2 2a15 15 0 0 1 -15 -15a2 2 0 0 1 2 -2" />
          </svg>
        </a>

        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8">
            <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
          </svg>
        </a>
        </div>
      </div>

      <aside
        data-cat-panel
        class="cat-panel hidden relative w-full max-w-[600px] min-h-80 justify-self-center overflow-hidden rounded-2xl border border-slate-700 bg-slate-900 shadow-2xl shadow-black/30"
        aria-live="polite"
      >
        <button
          type="button"
          data-cat-close
          aria-label="Close cat surprise"
          class="absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-slate-950/80 text-xl text-slate-200 transition-colors hover:bg-slate-800 hover:text-white"
        >
          ×
        </button>

        <div data-cat-status class="absolute inset-0 flex items-center justify-center px-8 text-center text-sm text-slate-400">
          Summoning a cat...
        </div>

        <img
          data-cat-image
          alt="Random cat"
          class="hidden h-80 w-full object-cover object-center sm:h-96 lg:h-[480px] xl:h-[560px]"
        />

        <p
          data-cat-caption
          class="hidden border-t border-slate-700 bg-slate-950/90 px-5 py-4 text-center text-sm font-semibold text-slate-100"
        ></p>
      </aside>
    </div>
  </div>
</div>

<script>
  const surpriseButton = document.querySelector<HTMLButtonElement>("[data-surprise]");
  const catPanel = document.querySelector<HTMLElement>("[data-cat-panel]");
  const catImage = document.querySelector<HTMLImageElement>("[data-cat-image]");
  const catCaption = document.querySelector<HTMLElement>("[data-cat-caption]");
  const catStatus = document.querySelector<HTMLElement>("[data-cat-status]");
  const catClose = document.querySelector<HTMLButtonElement>("[data-cat-close]");

  const captions = [
    "Works on my machine.",
    "The local LLM is thinking.",
    "One more commit, then sleep.",
    "Professional debugging assistant.",
    "Code review approved.",
    "Deploying directly to production.",
  ];

  surpriseButton?.addEventListener("click", async () => {
    if (!catPanel || !catImage || !catCaption || !catStatus) return;

    catPanel.classList.remove("hidden");
    catImage.classList.add("hidden");
    catCaption.classList.add("hidden");
    catStatus.classList.remove("hidden");
    catStatus.textContent = "Summoning a cat...";
    surpriseButton.disabled = true;

    try {
      const response = await fetch("https://api.thecatapi.com/v1/images/search");
      if (!response.ok) throw new Error("Cat request failed");

      const cats = (await response.json()) as Array<{ url: string }>;
      if (!cats[0]?.url) throw new Error("No cat returned");

      catImage.onload = () => {
        catStatus.classList.add("hidden");
        catImage.classList.remove("hidden");
        catCaption.classList.remove("hidden");
      };
      catImage.onerror = () => {
        catStatus.textContent = "The cat escaped. Try Surprise again.";
      };
      catCaption.textContent = captions[Math.floor(Math.random() * captions.length)];
      catImage.src = cats[0].url;

      if (window.innerWidth < 1024) {
        catPanel.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    } catch {
      catStatus.textContent = "The cat escaped. Try Surprise again.";
    } finally {
      surpriseButton.disabled = false;
    }
  });

  catClose?.addEventListener("click", () => {
    catPanel?.classList.add("hidden");
  });
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
  }

  .animation-delay-800 {
    animation-delay: 0.8s;
  }

  .animation-delay-1000 {
    animation-delay: 1s;
  }

  .cat-panel:not(.hidden) {
    animation: catReveal 0.35s ease-out;
  }

  @keyframes catReveal {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in {
      animation: none;
      opacity: 1;
    }
  }
</style>
