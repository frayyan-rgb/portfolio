---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-white">Projects</h2>
            <div class="w-[75px] h-[5px] mt-2 rounded-full" style={`background-color: ${siteConfig.accentColor}`} />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.projects.map((project, index) => (
                <article class="relative p-4 sm:p-6 md:p-8 bg-slate-900 rounded-xl sm:rounded-2xl border border-slate-800 transition-all duration-300 hover:bg-slate-900/80 hover:shadow-xl hover:shadow-blue-950/30 hover:border-slate-700 hover:-translate-y-1">
                  <div class="space-y-4">
                    <div>
                      <span class="text-sm font-mono" style={{ color: siteConfig.accentColor }}>0{index + 1}</span>
                      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 sm:gap-4 mt-1">
                        <div>
                          <h3 class="text-xl sm:text-2xl font-bold text-white">{project.name}</h3>
                          <p class="text-sm sm:text-base font-medium text-slate-400">{project.subtitle}</p>
                        </div>
                        <span class="text-xs sm:text-sm font-semibold sm:text-right" style={{ color: siteConfig.accentColor }}>
                          {project.context}
                        </span>
                      </div>
                    </div>

                    <p class="text-base sm:text-lg text-slate-300 leading-relaxed">{project.description}</p>

                    <ul class="space-y-2">
                      {project.bullets.map((bullet) => (
                        <li class="flex items-start">
                          <span class="inline-block w-1.5 h-1.5 rounded-full bg-slate-500 mt-2 mr-3 flex-shrink-0" />
                          <span class="text-sm sm:text-base text-slate-300">{bullet}</span>
                        </li>
                      ))}
                    </ul>

                    <div class="flex flex-wrap gap-2 pt-1">
                      {project.links.map((link) => (
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-sm font-semibold text-slate-950 transition-opacity hover:opacity-80"
                          style={`background-color: ${siteConfig.accentColor}`}
                        >
                          {link.label} <span aria-hidden="true">↗</span>
                        </a>
                      ))}
                    </div>

                    <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                      {project.skills.map((skill) => (
                        <span class="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-slate-800 text-slate-200 border border-slate-700 rounded-md sm:rounded-lg text-xs sm:text-sm font-medium">{skill}</span>
                      ))}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
